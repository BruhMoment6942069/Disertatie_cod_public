void graphData::pushDataToBuffer(double x1, double y1, double x2, double y2) {

    QMutexLocker locker(&m_mutex);

    m_buffer[0].append(QPointF(m_time, x1));
    m_buffer[1].append(QPointF(m_time, y1));
    m_buffer[2].append(QPointF(m_time, x2));
    m_buffer[3].append(QPointF(m_time, y2));

    m_time += 0.05;
    //qDebug() << m_buffer << "buffer";
}

void graphData::clearData() {
    QMutexLocker locker(&m_mutex);
    for (int i = 0; i < 4; i++) {
        m_buffer[i].clear();
        series[i]->clear();
    }
    m_time = 0.0;
}

void graphData::updateGraph() {
    for (int i = 0; i < 4; i++) {

        QList<QPointF> dataToDraw;
        QMutexLocker locker(&m_mutex);
        dataToDraw = m_buffer[i];
        m_buffer[i].clear();
        series[i]->append(dataToDraw);
        while (series[i]->count() > 100) {
            series[i]->remove(0);
        }
    }
    double xMax = m_time;
    double xMin = xMax - 100 * 0.05;
    m_axisX->setRange(xMin, xMax);

}
